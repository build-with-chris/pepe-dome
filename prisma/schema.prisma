generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Subscriber {
  id                String            @id @default(uuid())
  email             String            @unique
  firstName         String?           @map("first_name")
  status            SubscriberStatus  @default(PENDING)
  interests         Json              @default("[]")
  doubleOptInToken  String?           @unique @map("double_opt_in_token")
  doubleOptInSentAt DateTime?         @map("double_opt_in_sent_at")
  /// Dauerhaftes Geheimnis für den Abmeldelink in jeder Mail.
  /// Ohne dieses Token genügte die bloße E-Mail-Adresse zum Austragen — damit
  /// konnte jeder Fremde eine beliebige Adresse aus dem Verteiler entfernen.
  /// Bleibt über die gesamte Lebensdauer gültig, weil Mails jahrelang im
  /// Postfach liegen und der Abmeldelink darin funktionieren muss.
  ///
  /// Der @default ist ein Sicherheitsnetz, kein Ersatz: Ohne ihn müsste jede
  /// Stelle, die einen Abonnenten anlegt, an das Feld denken — ein vergessener
  /// Aufruf bricht erst zur Laufzeit, und in Tests und Skripten fällt das lange
  /// nicht auf. Die regulären Wege setzen weiterhin ein eigenes 256-Bit-Token
  /// über generateUnsubscribeToken(); gen_random_uuid() liefert 122 Bit und ist
  /// damit ebenfalls nicht zu erraten.
  ///
  /// Der Default sitzt bewusst in der Datenbank und nicht nur im Prisma-Client:
  /// so greift er auch bei rohem SQL, etwa in einem Seed-Skript.
  unsubscribeToken  String            @unique @default(dbgenerated("(gen_random_uuid())::text")) @map("unsubscribe_token")
  confirmedAt       DateTime?         @map("confirmed_at")
  unsubscribedAt    DateTime?         @map("unsubscribed_at")
  lastOpenAt        DateTime?         @map("last_open_at")
  lastClickAt       DateTime?         @map("last_click_at")
  metadata          Json              @default("{}")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at")
  newsletterEvents  NewsletterEvent[]

  @@index([email])
  @@index([status])
  @@index([interests])
  @@map("subscribers")
}

model Newsletter {
  id             String              @id @default(uuid())
  slug           String              @unique
  subject        String
  preheader      String?
  heroImageUrl   String?             @map("hero_image_url")
  heroTitle      String?             @map("hero_title")
  heroSubtitle   String?             @map("hero_subtitle")
  heroCTALabel   String?             @map("hero_cta_label")
  heroCTAUrl     String?             @map("hero_cta_url")
  status         NewsletterStatus    @default(DRAFT)
  scheduledAt    DateTime?           @map("scheduled_at")
  sentAt         DateTime?           @map("sent_at")
  recipientCount Int                 @default(0) @map("recipient_count")
  createdBy      String?             @map("created_by")
  metadata       Json                @default("{}")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at")
  introText      String?             @map("intro_text")
  content        NewsletterContent[]
  events         NewsletterEvent[]
  stats          NewsletterStats?

  @@index([status])
  @@index([slug])
  @@index([scheduledAt])
  @@map("newsletters")
}

model NewsletterContent {
  id                 String      @id @default(uuid())
  newsletterId       String      @map("newsletter_id")
  contentType        ContentType
  contentId          String?     @map("content_id")
  sectionHeading     String?     @map("section_heading")
  sectionDescription String?     @map("section_description")
  orderPosition      Int         @default(0) @map("order_position")
  createdAt          DateTime    @default(now()) @map("created_at")
  newsletter         Newsletter  @relation(fields: [newsletterId], references: [id], onDelete: Cascade)

  @@index([newsletterId])
  @@index([newsletterId, orderPosition])
  @@map("newsletter_content")
}

model NewsletterStats {
  id               String     @id @default(uuid())
  newsletterId     String     @unique @map("newsletter_id")
  sentCount        Int        @default(0) @map("sent_count")
  deliveredCount   Int        @default(0) @map("delivered_count")
  openCount        Int        @default(0) @map("open_count")
  uniqueOpenCount  Int        @default(0) @map("unique_open_count")
  clickCount       Int        @default(0) @map("click_count")
  uniqueClickCount Int        @default(0) @map("unique_click_count")
  bounceCount      Int        @default(0) @map("bounce_count")
  complaintCount   Int        @default(0) @map("complaint_count")
  unsubscribeCount Int        @default(0) @map("unsubscribe_count")
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at")
  newsletter       Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)

  @@map("newsletter_stats")
}

model NewsletterEvent {
  id            String      @id @default(uuid())
  newsletterId  String?     @map("newsletter_id")
  subscriberId  String?     @map("subscriber_id")
  eventType     EventType   @map("event_type")
  eventData     Json        @default("{}") @map("event_data")
  resendEventId String?     @map("resend_event_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  newsletter    Newsletter? @relation(fields: [newsletterId], references: [id])
  subscriber    Subscriber? @relation(fields: [subscriberId], references: [id])

  @@index([newsletterId])
  @@index([subscriberId])
  @@index([eventType])
  @@index([createdAt])
  /// Webhook-Zuordnung über die Resend-email_id (Fallback ohne Tags)
  @@index([resendEventId])
  @@map("newsletter_events")
}

model TestRecipient {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("test_recipients")
}

model CourseInterest {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String?
  courseSlug  String   @map("course_slug")
  courseTitle String   @map("course_title")
  gdprConsent Boolean  @default(false) @map("gdpr_consent")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([courseSlug])
  @@index([createdAt])
  @@map("course_interests")
}

model Event {
  id            String              @id @default(uuid())
  slug          String              @unique
  title         String
  subtitle      String?
  description   String
  date          DateTime
  endDate       DateTime?           @map("end_date")
  /// Beginn als "HH:MM". Das Format setzt die API durch (src/lib/event-time.ts),
  /// die Ausgabe läuft überall über formatTimeShort/formatTimeRange.
  time          String?
  /// Ende als "HH:MM", optional. Ergibt auf der Detailseite "20:00 bis 22:00 Uhr".
  endTime       String?             @map("end_time")
  location      String
  category      EventCategory
  ticketUrl     String?             @map("ticket_url")
  price         String?
  /// Trailer: entweder ein YouTube-/Vimeo-Link oder ein Pfad auf eine Datei im
  /// Projekt ("/videos/showreel.mp4"). Was gültig ist, entscheidet allein
  /// src/lib/event-trailer.ts — Admin-Formular und Website fragen dort.
  trailerUrl    String?             @map("trailer_url")
  imageUrl      String?             @map("image_url")
  featured      Boolean             @default(false)
  highlights    Json                @default("[]")
  /// Übersetzungen pro Locale, z.B. { "en": { "title": …, "description": … } }.
  /// Deutsch bleibt die Quelle in den Hauptspalten; fehlende Felder fallen auf DE zurück.
  translations  Json                @default("{}")
  status        ContentStatus       @default(DRAFT)
  createdBy     String?             @map("created_by")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at")
  recurrence    RecurrencePattern?  @map("recurrence")
  recurrenceEnd DateTime?           @map("recurrence_end")
  parentEventId String?             @map("parent_event_id")
  articles      ArticleEvent[]
  parentEvent   Event?              @relation("EventRecurrence", fields: [parentEventId], references: [id])
  childEvents   Event[]             @relation("EventRecurrence")
  distributions EventDistribution[]

  @@index([slug])
  @@index([date])
  @@index([category])
  @@index([status])
  @@index([featured])
  @@map("events")
}

/// Verteilung eines Events an externe Kanäle.
///
/// Die Tabelle liegt seit dem ersten Aufbau in der Datenbank, ist leer und wird
/// von keiner Stelle im Code angesprochen: ein angefangenes Feature, das nie
/// fertig wurde. Sie steht hier trotzdem, weil Prisma sonst bei jeder Migration
/// vorschlägt, sie samt ihrer beiden Enums zu löschen. Über ihr Ende soll
/// bewusst entschieden werden, nicht als Nebenwirkung eines `migrate dev`.
model EventDistribution {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String              @map("event_id")
  channel      DistributionChannel
  status       DistributionStatus  @default(pending)
  externalId   String?             @map("external_id")
  externalUrl  String?             @map("external_url")
  errorMessage String?             @map("error_message")
  attemptedAt  DateTime            @default(now()) @map("attempted_at") @db.Timestamptz(6)
  completedAt  DateTime?           @map("completed_at") @db.Timestamptz(6)
  event        Event               @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([eventId, channel])
  @@index([eventId], map: "event_distributions_event_idx")
  @@index([status])
  @@map("event_distributions")
}

model Article {
  id          String         @id @default(uuid())
  slug        String         @unique
  title       String
  excerpt     String
  content     String
  category    String
  author      String
  imageUrl    String?        @map("image_url")
  tags        Json           @default("[]")
  featured    Boolean        @default(false)
  status      ContentStatus  @default(DRAFT)
  publishedAt DateTime?      @map("published_at")
  createdBy   String?        @map("created_by")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at")
  events      ArticleEvent[]

  @@index([slug])
  @@index([category])
  @@index([status])
  @@index([publishedAt])
  @@index([featured])
  @@map("articles")
}

model ArticleEvent {
  id        String   @id @default(uuid())
  articleId String   @map("article_id")
  eventId   String   @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([articleId, eventId])
  @@map("article_events")
}

/**
 * Zugriffsanfrage für das Admin-Panel.
 * Wer sich neu anmeldet, hat zunächst keine Rechte. Beim ersten Aufruf des
 * Panels entsteht hier ein Eintrag und eine Freigabe-Mail geht raus. Die
 * verbindliche Rolle liegt danach in den Clerk-publicMetadata; diese Tabelle
 * ist der Antrag samt Protokoll, wer wann was freigegeben hat.
 */
model AdminAccessRequest {
  id           String                   @id @default(uuid())
  clerkUserId  String                   @unique @map("clerk_user_id")
  email        String
  name         String?
  status       AdminAccessRequestStatus @default(PENDING)
  /// Einmal-Token für den Freigabe-Link in der Mail
  token        String                   @unique
  tokenExpires DateTime                 @map("token_expires")
  /// Welche Rolle wurde am Ende vergeben (nur bei APPROVED gesetzt)
  grantedRole  String?                  @map("granted_role")
  decidedAt    DateTime?                @map("decided_at")
  /// Clerk-User-ID des Super Admins, der entschieden hat
  decidedBy    String?                  @map("decided_by")
  notifiedAt   DateTime?                @map("notified_at")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  @@index([status])
  @@index([email])
  @@map("admin_access_requests")
}

enum AdminAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

enum NewsletterStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
}

enum ContentType {
  EVENT
  ARTICLE
  SHOW
  CUSTOM_SECTION
}

enum EventType {
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  UNSUBSCRIBED
}

enum EventCategory {
  SHOW
  PREMIERE
  FESTIVAL
  WORKSHOP
  OPEN_TRAINING
  KINDERTRAINING
  BUSINESS
  OPEN_AIR
  EVENT
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Gehören zu EventDistribution, siehe Kommentar dort.
enum DistributionChannel {
  eventbrite
  facebook_page
  instagram_business
  google_business_profile
  rausgegangen_feed
  jsonld_website
  // Kanal-Kit: Ziele, die nur ein Formular haben und deshalb von Hand
  // eingetragen werden. Angehängt statt einsortiert, weil ALTER TYPE ADD VALUE
  // ohne Position schreibt und eine Umsortierung den Typ neu bauen müsste.
  in_muenchen
  whatsapp
  presse

  @@map("distribution_channel")
}

enum DistributionStatus {
  pending
  success
  failed
  skipped

  @@map("distribution_status")
}

enum RecurrencePattern {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

/// Ein Reel im 12-Wochen-Contentplan.
///
/// Der Plan lebt von einer einzigen Zahl, die wöchentlich kontrolliert wird:
/// wie viele Reels fertig geschnitten und noch ungepostet sind. Genau deshalb
/// ist der Status hier eine Stufe im Produktionsweg und kein Freitext.
model ContentReel {
  id               String     @id @default(uuid())
  /// Laufende Nummer im Plan, 1 bis 12. Bestimmt die Reihenfolge und legt fest,
  /// welche Reels die Baseline bilden (die ersten fünf). Unique, damit zwei
  /// gleichzeitig angelegte Reels nicht dieselbe Nummer bekommen und die
  /// Baseline stillschweigend auf sechs Zeilen wächst.
  position         Int        @unique
  artist           String
  discipline       String
  status           ReelStatus @default(PLANNED)
  /// Batch-Drehtag, an dem das Rohmaterial entstanden ist.
  shootDate        DateTime?  @map("shoot_date")
  /// Wann der Schnitt fertig war. Ab hier zählt das Reel in den Puffer.
  editedAt         DateTime?  @map("edited_at")
  /// Geplanter Slot, in aller Regel ein Donnerstag 18:00.
  plannedFor       DateTime?  @map("planned_for")
  publishedAt      DateTime?  @map("published_at")
  /// Shares und Saves getrennt, weil Instagram sie getrennt ausweist und eine
  /// vorab addierte Summe sich später nicht mehr aufteilen lässt.
  shares48         Int?       @map("shares_48h")
  saves48          Int?       @map("saves_48h")
  /// Der 72-Stunden-Wert bleibt als Vergleichsgröße erhalten. Gerechnet wird
  /// mit 48 Stunden, siehe src/lib/contentplan.ts.
  shares72         Int?       @map("shares_72h")
  saves72          Int?       @map("saves_72h")
  budgetReleasedAt DateTime?  @map("budget_released_at")
  /// Ausgaben in Cent. Als Ganzzahl, damit sich über zwölf Wochen keine
  /// Rundungsreste summieren.
  spendCents       Int?       @map("spend_cents")
  /// Ergebnisse laut Ads Manager, Grundlage für die Kosten pro Ergebnis.
  results          Int?
  notes            String?
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at")

  @@index([status])
  @@index([plannedFor])
  @@map("content_reels")
}

/// Einstellungen des Contentplans, genau eine Zeile.
///
/// Die Schwelle steht bewusst als eigener Wert in der Datenbank und wird nicht
/// bei jedem Aufruf aus dem Median gerechnet. Sonst wandert sie mit jedem neuen
/// Reel, und im Oktober kann niemand mehr sagen, wogegen im September gemessen
/// wurde. Einmal fixiert heißt einmal fixiert.
model ContentPlanConfig {
  /// Immer 1. Eine feste Id ist der einfachste Weg, eine zweite Zeile
  /// auszuschließen, ohne dafür einen Trigger zu schreiben.
  id             Int       @id @default(1)
  /// Median Shares plus Saves der ersten fünf Reels nach 48 Stunden.
  baselineMedian Int?      @map("baseline_median")
  /// Ab dieser Summe gilt ein Reel als Gewinner und bekommt Budget.
  threshold      Int?
  fixedAt        DateTime? @map("fixed_at")
  /// Median der sporadischen Reels von vor dem Plan. Referenzwert für den
  /// Abbruchtest nach den ersten drei Reels. Muss vor dem Start einmal aus den
  /// Insights gezogen werden, sonst gibt es am Stichtag nichts zu vergleichen.
  priorMedian    Int?      @map("prior_median")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("content_plan_config")
}

enum ReelStatus {
  PLANNED
  FILMED
  EDITED
  PUBLISHED

  @@map("reel_status")
}

// ── Kursprogramm ────────────────────────────────────────────────────────────
// Ein Kurs ist ein Angebot, kein Termin. „Luftakrobatik" läuft viermal die
// Woche, ist aber eine Zeile mit vier Slots. Vorher standen die vier Termine
// als vier vollständige Kopien im Code — als der Trainername korrigiert werden
// musste, waren es drei Stellen. Genau das soll die Trennung verhindern.

model Course {
  id           String        @id @default(uuid())
  /// Stabil ab dem Anlegen. Hängt an geteilten Links (?kurs=<slug>) und wird
  /// beim Umbenennen des Titels bewusst NICHT neu erzeugt.
  slug         String        @unique
  title        String
  /// Zeile unter dem Titel, z.B. „5 bis 12 Jahre · mit Michael".
  sub          String?
  description  String
  /// Stichpunkte für das Detail-Fenster. String-Array als Json, wie
  /// Event.highlights.
  inhalte      Json          @default("[]")
  /// Kurze Altersangabe, steht oben auf der Kurskarte: „Für Kinder von 5 bis 12".
  /// Ohne Angabe fällt die Karte auf die Zielgruppe zurück.
  alter        String?
  fuerWen      String        @map("fuer_wen")
  target       CourseTarget
  trainer      String
  /// Gesetzt heißt: Buchung läuft nicht über Eversports, sondern hier direkt
  /// (https://… oder mailto:…). Siehe Luftakrobatik über Aircrobatic Studios.
  bookingUrl   String?       @map("booking_url")
  bookingLabel String?       @map("booking_label")
  bookingNote  String?       @map("booking_note")
  /// Bilder des Kurses als [{ "url": "/kurse/…", "alt": "…" }, …].
  /// Das erste Bild steht auf der Kurskarte, alle zusammen bilden die
  /// Galerie im Detail-Fenster. Leer ist zulaessig: die Karte rendert dann
  /// ohne Bild, so wie vor dieser Erweiterung.
  images       Json          @default("[]")
  /// PUBLISHED steht auf der Website, ARCHIVED ist pausiert und bleibt im
  /// Admin samt Texten erhalten. DRAFT ist noch nie veröffentlicht.
  status       ContentStatus @default(DRAFT)
  /// Reihenfolge innerhalb eines Tages. Kleiner zuerst, bei Gleichstand
  /// entscheidet die Startzeit.
  sortOrder    Int           @default(0) @map("sort_order")
  createdBy    String?       @map("created_by")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")
  slots        CourseSlot[]

  @@index([slug])
  @@index([status])
  @@index([target])
  @@map("courses")
}

model CourseSlot {
  id        String @id @default(uuid())
  courseId  String @map("course_id")
  /// 1 = Montag … 7 = Sonntag (ISO-8601). Nicht 0-basiert, damit niemand
  /// versehentlich Sonntag als 0 an den Anfang der Woche sortiert.
  weekday   Int
  /// „HH:MM", durchgesetzt von der API. Format wie bei Event.time.
  startTime String @map("start_time")
  endTime   String @map("end_time")
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([weekday])
  @@map("course_slots")
}

model ScheduleNote {
  /// Der Wochentag ist der Schlüssel: pro Tag höchstens eine Notiz.
  weekday   Int      @id
  /// „Tricking & Breaking in Planung, Termine folgen." Leerer Text heißt:
  /// keine Notiz anzeigen.
  text      String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("schedule_notes")
}

enum CourseTarget {
  /// Anzeigename ist „Jugendliche"; der technische Name bleibt teens, damit
  /// aus einer Umbenennung keine Datenmigration wird.
  kinder
  teens
  erwachsene

  @@map("course_target")
}
