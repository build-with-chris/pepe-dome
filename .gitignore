# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/generated/prisma

# uploaded files
/public/uploads/*
!/public/uploads/.gitkeep

# clerk configuration (can include secrets)
/.clerk/

# Agent-Worktrees (temporär, nicht versionieren)
.claude/worktrees/

# Lokale Layout-Vorschau (scripts/preview-newsletter.ts)
.preview/

# Kamera-Originale der Kursbilder: bleiben lokal.
# Ausgeliefert werden die verkleinerten Fassungen unter public/kurse
# (76 MB Originale gegen 4 MB Web-Groesse, und das Repo ist oeffentlich).
/public/Kursbilder/

# Kamera-Originale der Galerie-Ordner: bleiben lokal, rund 3 GB.
# Alles unter public/ wird mit deployed und waere oeffentlich abrufbar.
# Ausgeliefert wird nur, was scripts/optimize-gallery-images.mjs daraus
# nach public/images/{festival,dome,cafe,circus-poetry}/ schreibt.
/public/✺ Freeman Festival - Pepe /
/public/dome-atmosphaere/
/public/Pepe Dome - Circus and Poetry/

# Sichtbogen aus scripts/contact-sheet.mjs und scripts/review-sheet.mjs
.contact/
