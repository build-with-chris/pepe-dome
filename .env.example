# Database
DATABASE_URL="postgresql://user:password@localhost:5432/pepe_dome?schema=public"
# Bei Supabase (Session-Mode Pooler): connection_limit setzen, sonst "MaxClientsInSessionMode" beim Newsletter-Versand.
# Beispiel: ...?schema=public&connection_limit=3

# Resend Email Service
RESEND_API_KEY="re_xxxxx"
# PFLICHT in Produktion: Der Webhook weist unsignierte Requests ab, wenn dieser Wert fehlt.
# Ohne ihn koennte jeder fremde Adressen als "bounced" melden und aus dem Verteiler werfen.
RESEND_WEBHOOK_SECRET="whsec_xxxxx"
RESEND_FROM_EMAIL="PEPE Dome <info@pepe-dome.de>"

# App Configuration (Basis-URL für Newsletter-Bestätigung, Abmeldelinks etc.)
# In Produktion auf die echte Domain setzen, z. B. https://pepe-dome.de
NEXT_PUBLIC_APP_URL="http://localhost:3004"
# Alternativ/fallback:
# NEXT_PUBLIC_BASE_URL="http://localhost:3004"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxx"
CLERK_SECRET_KEY="sk_test_xxxxx"
# Optional: set to "true" in development to browse the frontend without login (skips Clerk; admin routes unprotected)
# NEXT_PUBLIC_DISABLE_CLERK_IN_DEV="true"

# Cron Jobs
CRON_SECRET="your-secret-token-for-cron-jobs"

# File Storage (if using S3)
# S3_BUCKET="pepedome-newsletter-images"
# S3_REGION="eu-central-1"
# AWS_ACCESS_KEY_ID="xxxxx"
# AWS_SECRET_ACCESS_KEY="xxxxx"

# DeepL API für automatische Event-Übersetzungen (Admin). Free-Keys enden auf ":fx".
DEEPL_API_KEY=""

# Google Places API (New) für den Café-Review-Slider
# Key mit aktivierter "Places API (New)" + Place-ID des Cafés (ChIJ...)
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACES_ID=""

# ── Tracking & Conversion-Messung ────────────────────────────────────
# Nichts davon laedt ohne Einwilligung im Cookie-Banner (src/lib/consent.ts).

# Google Analytics 4. Ohne Wert greift die bisher fest verdrahtete ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-CGE01LR2LC"

# Meta Pixel. Events Manager → Datenquellen → Dataset-ID (15 bis 16 Ziffern).
# Ohne diese ID wird das Pixel nicht geladen und /api/track antwortet folgenlos.
NEXT_PUBLIC_META_PIXEL_ID=""

# Conversions API. Events Manager → Einstellungen → Zugriffstoken generieren.
# GEHEIM: nur in Vercel als Environment Variable setzen, nie ins Repo.
# Das Repo ist oeffentlich — ein Token hier waere sofort kompromittiert.
META_CAPI_ACCESS_TOKEN=""

# Nur voruebergehend zum Testen setzen (Events Manager → Testereignisse).
# In Produktion leer lassen, sonst zaehlen die Ereignisse nicht.
META_CAPI_TEST_EVENT_CODE=""

# Admin-Zugriff
# Notausgang: Diese Adressen sind immer Super Admin, unabhaengig von Clerk-Metadaten.
# Ohne mindestens einen Eintrag kann nach einem frischen Setup niemand Rollen vergeben.
# Mehrere Adressen kommagetrennt.
SUPER_ADMIN_EMAILS="deine-adresse@example.com"
# Adresse, an die Freigabe-Anfragen fuer das Admin-Panel gehen (Default: info@pepe-dome.de)
# ADMIN_APPROVAL_EMAIL="info@pepe-dome.de"
